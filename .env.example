# ─────────────────────────────────────────────
# Portfolio Analyzer — variáveis de ambiente
# Copie este arquivo para .env e preencha o que for usar.
# O arquivo .env contém credenciais: não versione e não compartilhe.
# ─────────────────────────────────────────────

# --- Análise por IA (opcional) ---------------
# Sem esta chave o sistema continua funcionando: cotações, cálculo de CDBs,
# alocação e alertas são todos calculados localmente.
# Obtenha em: https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxx

# Modelo e profundidade da análise (opcionais).
# Modelos suportados: claude-opus-5, claude-sonnet-5, claude-fable-5.
# O claude-sonnet-5 custa bem menos e dá conta desta análise sem dificuldade.
# effort: low | medium | high | xhigh | max — maior custo e latência a cada nível.
ANTHROPIC_MODEL=claude-opus-5
ANTHROPIC_EFFORT=medium

# --- Telegram (opcional) ---------------------
# Crie um bot via @BotFather e copie o token.
TELEGRAM_BOT_TOKEN=1234567890:ABCdefGHIjklMNOpqrSTUvwxYZ

# Envie uma mensagem ao seu bot e acesse:
# https://api.telegram.org/bot{SEU_TOKEN}/getUpdates
# O chat_id aparece em "message.chat.id".
TELEGRAM_CHAT_ID=123456789

# --- Cotações (opcional) ---------------------
# A fonte primária é o Yahoo Finance, que não exige cadastro.
# O token da brapi.dev só é usado como alternativa, quando o Yahoo falha.
# BRAPI_TOKEN=
