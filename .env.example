# ─────────────────────────────────────────────
# Analisador de Finanças — variáveis de ambiente
# Copie este arquivo para .env e preencha o que for usar.
# O arquivo .env contém credenciais: não versione e não compartilhe.
#
# Este arquivo manda: o que estiver aqui tem precedência sobre variáveis já
# definidas no ambiente. Nenhum modelo e nenhum esforço é fixo no código —
# se o bloco do provedor não estiver preenchido, a análise por IA fica
# indisponível (o resto do sistema continua funcionando).
# ─────────────────────────────────────────────

# --- Provedor da análise por IA (opcional) ---
# Qual bloco abaixo vale. O nome vira o prefixo das variáveis em maiúsculas:
# anthropic -> ANTHROPIC_*, kimi -> KIMI_*. Padrão: anthropic.
IA_PROVEDOR=anthropic

# ─── Anthropic ───────────────────────────────
# Onde a chave da API deve ser buscada:
#   arquivo  -> somente em ANTHROPIC_API_KEY, aqui neste .env (falha se faltar)
#   ambiente -> somente na variável de ambiente nomeada em ANTHROPIC_VARIAVEL_CHAVE
ANTHROPIC_ORIGEM_CHAVE=arquivo

# Usada quando ORIGEM_CHAVE=arquivo. Obtenha em:
# https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxx

# Usada quando ORIGEM_CHAVE=ambiente: o NOME da variável de ambiente que
# guarda a chave (não a chave em si).
# ANTHROPIC_VARIAVEL_CHAVE=ANTHROPIC_API_KEY

# Modelo e profundidade da análise — obrigatórios, sem padrão no código.
# Modelos: claude-opus-5, claude-sonnet-5, claude-fable-5.
# O claude-sonnet-5 custa bem menos e dá conta desta análise sem dificuldade.
# effort: low | medium | high | xhigh | max — maior custo e latência a cada
# nível; use "nenhum" para não enviar o campo ao provedor.
ANTHROPIC_MODEL=claude-opus-5
ANTHROPIC_EFFORT=medium

# Ajustes opcionais deste provedor:
# ANTHROPIC_BASE_URL=            # outro endereço compatível com a API da Anthropic
# ANTHROPIC_FALLBACK=auto        # auto (pelo modelo) | sim | nao
# ANTHROPIC_BUSCA_WEB=sim        # sim | nao — ferramenta de busca do servidor
# ANTHROPIC_MAX_TOKENS=16000     # teto de tokens da resposta

# ─── Kimi (Moonshot AI) ──────────────────────
# Compatível com a API da Anthropic: o mesmo SDK atende, mudando o endereço.
# Para usar, troque IA_PROVEDOR para "kimi" e preencha o bloco.
# KIMI_ORIGEM_CHAVE=arquivo
# KIMI_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxx
# KIMI_VARIAVEL_CHAVE=MOONSHOT_API_KEY
# KIMI_MODEL=kimi-k2-thinking
# KIMI_EFFORT=nenhum             # o endpoint do Kimi não usa effort
# KIMI_BASE_URL=https://api.moonshot.ai/anthropic
# KIMI_FALLBACK=nao              # `fallbacks` é exclusivo da Anthropic
# KIMI_BUSCA_WEB=nao             # a busca web do servidor é exclusiva da Anthropic
# KIMI_MAX_TOKENS=16000

# --- Telegram (opcional) ---------------------
# Crie um bot via @BotFather e copie o token.
TELEGRAM_BOT_TOKEN=1234567890:ABCdefGHIjklMNOpqrSTUvwxYZ

# Envie uma mensagem ao seu bot e acesse:
# https://api.telegram.org/bot{SEU_TOKEN}/getUpdates
# O chat_id aparece em "message.chat.id".
TELEGRAM_CHAT_ID=123456789

# --- Cotações (opcional) ---------------------
# A fonte primária é o Yahoo Finance, que não exige cadastro.
# O token da brapi.dev só é usado como alternativa, quando o Yahoo falha.
# BRAPI_TOKEN=

# --- Dados (opcional) ------------------------
# Diretório onde a carteira, o cache e o histórico são gravados.
# Padrão: a pasta data/ do projeto. Usado principalmente pelos testes.
# PORTFOLIO_DATA_DIR=

# Arquivo .env alternativo, só para a configuração de IA acima.
# Padrão: o próprio .env do projeto. Usado principalmente pelos testes.
# IA_ENV_FILE=
